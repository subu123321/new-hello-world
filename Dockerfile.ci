# ---------------------------------------------------------------------------
# Lightweight image for CI pipelines (Jenkins / Azure DevOps) that have ALREADY
# run "mvn clean package", so the WAR exists at webapp/target/webapp.war.
# This avoids compiling the project twice.
#   docker build -f Dockerfile.ci -t hello-world-webapp .
# ---------------------------------------------------------------------------
FROM tomcat:9.0-jdk17-temurin

LABEL org.opencontainers.image.title="hello-world-webapp" \
      maintainer="valaxytech@gmail.com"

RUN rm -rf /usr/local/tomcat/webapps/*
COPY webapp/target/webapp.war /usr/local/tomcat/webapps/ROOT.war

USER 1001

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
  CMD curl -fsS http://localhost:8080/ > /dev/null || exit 1

CMD ["catalina.sh", "run"]
